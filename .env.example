# Job Bid Generator Environment Configuration
# Copy this file to .env and fill in your values

# OpenAI API Key (required for AI image analysis)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Company Information
COMPANY_NAME=Premium Metal Fabrication & Welding
COMPANY_ADDRESS=123 Industrial Way, Manufacturing City, ST 12345
COMPANY_PHONE=(555) 123-4567
COMPANY_EMAIL=bids@metalfab.com

# Pricing Configuration
PROFIT_MARGIN=0.25     # 25% profit margin
OVERHEAD_RATE=0.15     # 15% overhead rate
TAX_RATE=0.08          # 8% sales tax (if applicable)

# Flask Configuration
SECRET_KEY=change-this-to-a-random-secret-key
DEBUG=True
